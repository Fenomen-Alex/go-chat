{
  "name": "go-chat-gui",
  "outputtype": "default",
  "frontend:install": "npm install",
  "frontend:build": "npm run build",
  "frontend:dev:watch": "npm run dev",
  "frontend:dev:server": "npm run dev",
  "backend:install": "go install",
  "backend:build": "go build -tags wails,production -o go-chat-gui -ldflags=-s -w",
  "backend:dev:run": "go run .",
