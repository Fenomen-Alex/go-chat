{
  "name": "go-chat-gui-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Frontend for go-chat GUI",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "postbuild": "cp -r wailsjs ../cmd/build/frontend/wailsjs",
    "preview": "vite preview",
    "dev:backend": "cd ../cmd/chat-gui && CGO_LDFLAGS=\"-framework UniformTypeIdentifiers\" go run -tags production .",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:backend\""
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.5.0",
    "@fortawesome/free-solid-svg-icons": "^6.5.0",
    "@fortawesome/vue-fontawesome": "^3.0.5",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^8.2.2",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^7.0.2",
    "vite": "^5.0.0",
    "vue-tsc": "^3.3.13"
  }
}
